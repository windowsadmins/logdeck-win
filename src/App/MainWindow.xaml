<Window
    x:Class="LogDeck.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LogDeck">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar region (drag target) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
                <Image x:Name="TitleBarIcon" Width="16" Height="16" VerticalAlignment="Center" />
                <TextBlock Text="LogDeck" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock x:Name="VersionText" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <Border x:Name="ElevatedBadge" Visibility="Collapsed" VerticalAlignment="Center"
                        Padding="6,1" CornerRadius="4"
                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                    <TextBlock Text="Administrator" FontSize="11"
                               Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                </Border>
            </StackPanel>
        </Grid>

        <NavigationView x:Name="NavView" Grid.Row="1"
                        PaneDisplayMode="Top"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Logs" Tag="logs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Tools" Tag="tools">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
